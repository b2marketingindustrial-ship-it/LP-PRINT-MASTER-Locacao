---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.1), com o desvio visual aprovado para a Print Master
 * (mockup de abertura, 26/10/2026 — docs/BRIEFING.md): barra branca, logo sem placa e CTA em
 * pílula verde. A ordem continua a do padrão — logo · tagline · CTA —, sem menu nem âncoras.
 */
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/LOGO.png'
import { site } from '../data/site'
import { header, cta } from '../data/content'
---

<header class="sticky top-0 z-50 border-b border-primary-dark/10 bg-neutral-light/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-page items-center justify-between gap-3 px-4 py-3 sm:gap-6 sm:px-6 lg:px-10">
    {/* 1. Logo */}
    <a href="/" class="flex shrink-0 items-center">
      <Image
        src={logo}
        alt={site.brand}
        width={262}
        height={60}
        format="webp"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        class="h-9 w-auto sm:h-11 lg:h-[52px]"
      />
    </a>

    {/* 2. Tagline central (some no mobile) */}
    <span class="hidden flex-1 items-center justify-center gap-2.5 font-display text-[13px] font-bold tracking-[0.18em] text-ink/75 uppercase md:flex lg:text-[14px]">
      <span aria-hidden="true" class="size-1.5 rounded-full bg-brand-mint"></span>
      {header.tagline}
    </span>

    {/* 3. CTA em pílula verde, rótulo curto no mobile */}
    <button
      type="button"
      data-cta="header-cta"
      class="btn-slave-whats inline-flex shrink-0 items-center gap-2 rounded-full bg-primary-dark px-4 py-2.5 font-sans text-[12px] font-bold text-neutral-light shadow-[0_10px_24px_-12px_rgba(6,67,55,0.7)] transition-colors duration-200 hover:bg-primary-dark-800 sm:px-6 sm:py-3 sm:text-[14px]"
    >
      <Icon name="whatsapp" class="size-4 shrink-0" />
      <span class="sm:hidden">{cta.primaryShort}</span>
      <span class="hidden sm:inline">{cta.primary}</span>
    </button>
  </div>
</header>
