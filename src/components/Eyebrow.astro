---
/**
 * Rótulo acima dos títulos (padrão Print Master): traço de 40×3px + texto em caixa alta.
 * Todo eyebrow da página usa este componente.
 * - `tone="light"`: sobre fundo verde-escuro (traço e texto em menta).
 * - `tone="dark"` (padrão): sobre fundo claro (traço verde, texto cinza-verde).
 */
interface Props {
  tone?: 'light' | 'dark'
  marker?: boolean
  class?: string
}

const { tone = 'dark', marker = true, class: className = '' } = Astro.props

const text = tone === 'light' ? 'text-brand-mint' : 'text-ink-soft'
const line = tone === 'light' ? 'bg-brand-mint' : 'bg-accent-orange'
---

<span
  class:list={[
    'inline-flex items-center gap-4 font-sans text-[12.5px] font-bold tracking-[0.2em] uppercase',
    text,
    className,
  ]}
>
  {marker && <span aria-hidden="true" class:list={['h-[3px] w-10 shrink-0 rounded-full', line]} />}
  <slot />
</span>
