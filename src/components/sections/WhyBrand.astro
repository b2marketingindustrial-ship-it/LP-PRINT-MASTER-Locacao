---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * Variante local da Print Master (mockup aprovado em 26/10/2026, docs/BRIEFING.md):
 * bloco em largura total sobre a foto do escritório com a multifuncional (o degradê
 * verde à esquerda já vem na imagem), texto sobre a parte verde e 5 cards sobrepostos
 * à base. Continua sendo o bloco escuro da segunda metade, antes da conversão.
 */
import { Picture } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="diferenciais" tone={tone} rhythm={rhythm} container={false} class="relative" data-why>
  {/* Bloco em largura total sobre a foto */}
  <div class="why-hero relative overflow-hidden rounded-[40px] bg-primary-dark lg:rounded-[64px]">
    <Picture
      src={why.scene.src}
      alt={why.scene.alt}
      widths={[640, 1024, 1536, 1890]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="lazy"
      decoding="async"
      class="why-scene absolute inset-0 h-full w-full object-cover"
      pictureAttributes={{ class: 'absolute inset-0 h-full w-full' }}
    />
    <span aria-hidden="true" class="why-veil pointer-events-none absolute inset-0"></span>

    <div class="relative z-[2] mx-auto w-full max-w-page px-6 pt-14 pb-28 lg:px-10 lg:pt-20 lg:pb-36">
      <div class="relative max-w-xl lg:max-w-[680px]">
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -top-4 -left-0 size-[18px] border-t-2 border-l-2 border-brand-mint"
        ></span>
        <span class="inline-flex items-center pl-5 font-sans text-[12.5px] font-bold tracking-[0.22em] text-neutral-light/85 uppercase">
          {why.eyebrow}
        </span>
        <h2 class="mt-4 font-display text-[2.3rem] leading-[1.06] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-5xl lg:text-[3.1rem] xl:text-[3.4rem]">
          {why.titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h2>

        <span aria-hidden="true" class="mt-6 block h-[3px] w-20 rounded-full bg-brand-mint"></span>

        <p class="mt-6 max-w-[36rem] font-sans text-[17px] leading-relaxed text-neutral-light/85 sm:text-[19px]">
          {why.text}
        </p>

        <button
          type="button"
          data-cta="diferenciais-cta"
          class="btn-slave-whats group mt-8 inline-flex w-full items-center justify-center gap-3 rounded-sm bg-accent-orange px-7 py-4 font-sans text-[16px] font-bold text-neutral-light shadow-[0_16px_32px_-16px_rgba(0,0,0,0.6)] transition-colors duration-200 hover:bg-accent-orange-dark sm:w-auto"
        >
          {why.cta}
          <Icon
            name="arrow-right"
            class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </button>
      </div>
    </div>
  </div>

  {/* Cards sobrepostos à base do bloco */}
  <div class="relative z-10 mx-auto -mt-20 max-w-page px-6 lg:px-10">
    <ul
      class="why-track scroll-track -mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
      aria-label={why.eyebrow}
    >
      {why.reasons.map((reason) => (
        <li class="why-card group relative flex w-[78%] shrink-0 snap-start flex-col gap-2.5 overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light p-4 shadow-[0_24px_48px_-24px_rgba(0,24,48,0.45)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_32px_60px_-28px_rgba(0,33,71,0.5)] sm:w-[44%] lg:w-auto">
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
          />
          <div class="flex items-center gap-2.5">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-neutral-gray-100 text-primary-dark-800 transition-colors duration-300 group-hover:bg-accent-orange/10 group-hover:text-accent-orange">
              <Icon name={reason.icon} class="size-[18px]" />
            </span>
            <h3 class="line-clamp-2 flex min-h-[2.5em] items-center font-display text-[14px] leading-[1.25] font-extrabold text-ink">
              {reason.title}
            </h3>
          </div>
          <p class="line-clamp-2 min-h-[3.25em] font-sans text-[13px] leading-relaxed text-ink-soft">
            {reason.description}
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
      <button
        type="button"
        data-why-prev
        aria-label="Diferencial anterior"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4 rotate-180" />
      </button>
      <button
        type="button"
        data-why-next
        aria-label="Próximo diferencial"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</Section>

<style>
  .why-hero {
    isolation: isolate;
  }

  /* Mobile: a multifuncional aparece embaixo, sob um verde que segura o texto em cima. */
  .why-hero :global(.why-scene) {
    object-position: 80% 100%;
  }

  .why-veil {
    background: linear-gradient(
      180deg,
      rgb(5 61 49 / 0.96) 0%,
      rgb(5 61 49 / 0.88) 50%,
      rgb(5 61 49 / 0.35) 100%
    );
  }

  @media (min-width: 1024px) {
    .why-hero {
      min-height: 620px;
    }

    /* Desktop: a foto já traz o degradê verde à esquerda; o véu só reforça o texto. */
    .why-hero :global(.why-scene) {
      object-position: 50% 30%;
    }

    .why-veil {
      background: linear-gradient(
        90deg,
        rgb(5 61 49 / 0.75) 0%,
        rgb(5 61 49 / 0.45) 32%,
        transparent 58%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-card,
    .why-card * {
      transition: none !important;
    }

    .why-card:hover {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.why-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-why-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-why-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>
