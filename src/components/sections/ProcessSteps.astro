---
/**
 * Como funciona — fase "apoio" da biblioteca B2.
 *
 * Variante local da Print Master (mockup aprovado em 26/10/2026, docs/BRIEFING.md):
 * cabeçalho claro com o botão e a garantia à direita, e as etapas em 4 cards
 * verde-escuros numerados — eles são o bloco escuro desta metade da página.
 * Fundo e respiro continuam vindo da composição via `tone`/`rhythm`; o menta é uma
 * camada por cima do tom.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { process } from '@data/sections/processo'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const steps = process.steps
---

<Section id="processo" tone={tone} rhythm={rhythm} data-processo>
  <div class="pt-10 lg:pt-14">
    <div class="flex flex-col gap-7 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-3 font-sans text-[12.5px] font-bold tracking-[0.22em] text-primary-dark uppercase">
          <span aria-hidden="true" class="size-3 rounded-[3px] bg-brand-mint"></span>
          {process.eyebrow}
        </span>
        <h2 class="mt-4 font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark sm:text-5xl lg:text-[3.35rem]">
          {process.title}
        </h2>
        <p class="mt-4 font-sans text-[17px] leading-relaxed text-ink-soft sm:text-lg">
          {process.text}
        </p>
      </div>

      <div class="flex flex-col items-stretch gap-3 sm:items-start lg:shrink-0 lg:pt-3">
        <button
          type="button"
          data-cta="processo-cta"
          class="btn-slave-whats group inline-flex items-center justify-center gap-4 rounded-xl bg-primary-dark px-8 py-4 font-sans text-[16px] font-bold text-neutral-light shadow-[0_18px_36px_-18px_rgba(6,67,55,0.7)] transition-colors duration-200 hover:bg-accent-orange"
        >
          {process.cta}
          <Icon
            name="arrow-right"
            class="size-5 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </button>
        <span class="flex items-center gap-2 pl-1 font-sans text-[14px] text-ink-soft">
          <Icon name="shield" class="size-4 shrink-0 text-accent-orange" />
          {process.microcopy}
        </span>
      </div>
    </div>

    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" aria-label={process.eyebrow}>
      {steps.map((step, i) => (
        <li class="process-card relative flex flex-col overflow-hidden rounded-2xl p-7 ring-1 ring-brand-mint/25 shadow-[0_26px_50px_-30px_rgba(6,67,55,0.75)] lg:p-8">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-brand-mint/10 blur-2xl"
          />
          <span class="relative flex size-14 items-center justify-center rounded-xl bg-brand-mint-soft font-display text-xl font-extrabold text-primary-dark">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="relative mt-5 font-display text-[1.35rem] leading-snug font-extrabold text-neutral-light lg:text-[1.15rem] xl:text-[1.25rem]">
            {step.title}
          </h3>
          <p class="relative mt-3 font-sans text-[16px] leading-relaxed text-neutral-light/80">
            {step.description}
          </p>
          {step.when && (
            <span class="relative mt-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 font-sans text-[11px] font-bold tracking-[0.12em] text-neutral-light/85 uppercase">
              <Icon name="clock" class="size-3.5 shrink-0 text-brand-mint" />
              {step.when}
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  /* Camada clara sobre o tom da seção: sai do branco de `linhas` e chega no cinza-menta
     de `aplicacoes`, sem emenda entre as três. */
  :global([data-processo]) {
    background-image: linear-gradient(
      180deg,
      #ffffff 0%,
      var(--color-neutral-gray-100) 55%,
      var(--color-neutral-gray-100) 100%
    );
  }

  .process-card {
    background-image: linear-gradient(
      160deg,
      var(--color-primary-dark-800) 0%,
      var(--color-primary-dark) 100%
    );
  }
</style>
