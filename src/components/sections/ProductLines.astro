---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2.
 *
 * Variante local da Print Master (mockup aprovado em 26/10/2026, docs/BRIEFING.md):
 * cabeçalho com ajuda à direita, 4 cards brancos com foto grande em palco menta,
 * etiqueta, 2 características e botão de orçamento, e a faixa de marcas abaixo.
 * Fundo e respiro continuam vindo da composição via `tone`/`rhythm`; o menta é uma
 * camada por cima do tom, como as camadas decorativas das outras seções.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { productLines } from '@data/sections/linhas'
import { brands } from '@data/brands'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines = productLines.items
---

<Section id="linhas" tone={tone} rhythm={rhythm} data-linhas>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
    <div class="max-w-3xl">
      <Eyebrow>{productLines.eyebrow}</Eyebrow>
      <h2 class="mt-4 font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-ink sm:text-5xl lg:text-[3.35rem]">
        {productLines.title}
      </h2>
      <p class="mt-4 font-sans text-[17px] leading-relaxed text-ink-soft sm:text-lg">
        {productLines.text}
      </p>
    </div>

    <div class="shrink-0 lg:pb-2">
      <p class="font-sans text-[15px] font-medium text-ink">{productLines.help.text}</p>
      <button
        type="button"
        data-cta="linhas-ajuda"
        class="btn-slave-whats group mt-3 inline-flex items-center gap-3 rounded-full border-2 border-primary-dark px-6 py-3 font-sans text-[15px] font-bold text-primary-dark transition-colors duration-200 hover:bg-primary-dark hover:text-neutral-light"
      >
        {productLines.help.cta}
        <Icon
          name="arrow-right"
          class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
        />
      </button>
    </div>
  </div>

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" aria-label={productLines.eyebrow}>
    {lines.map((line) => (
      <li class="linhas-card group flex flex-col rounded-[22px] border border-primary-dark/10 bg-neutral-light p-3 shadow-[0_22px_44px_-30px_rgba(6,67,55,0.45)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgba(6,67,55,0.55)]">
        {/* Palco da foto */}
        <div class="linhas-stage relative flex aspect-[6/5] items-center justify-center overflow-hidden rounded-2xl">
          <span class="absolute top-3 left-3 z-[2] rounded-full bg-brand-mint-soft px-3 py-1.5 font-sans text-[10.5px] font-bold tracking-[0.08em] text-primary-dark uppercase ring-1 ring-brand-mint/50">
            {line.tag}
          </span>
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class="relative z-[1] mt-5 max-h-[84%] w-auto max-w-[92%] object-contain transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
        </div>

        {/* Conteúdo */}
        <div class="flex flex-1 flex-col px-3 pt-5 pb-3">
          <h3 class="font-display text-[1.35rem] leading-snug font-extrabold text-ink">
            {line.title}
          </h3>
          <p class="mt-2 font-sans text-[15px] leading-relaxed text-ink-soft">{line.description}</p>

          <ul class="mt-4 mb-6 flex flex-col gap-2.5">
            {line.features.map((feature) => (
              <li class="flex items-center gap-2.5 font-sans text-[14.5px] text-ink">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-mint-soft text-accent-orange ring-1 ring-brand-mint/50">
                  <Icon name="check" class="size-3.5" />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <button
            type="button"
            data-cta={`linhas-${line.id}`}
            class="btn-slave-whats mt-auto flex w-full items-center justify-between gap-3 rounded-xl bg-primary-dark px-5 py-3.5 font-sans text-[15px] font-bold text-neutral-light transition-colors duration-200 hover:bg-accent-orange"
          >
            <span>{productLines.itemCta}</span>
            <Icon name="arrow-right" class="size-4 shrink-0" />
          </button>
        </div>
      </li>
    ))}
  </ul>

  {/* Faixa de marcas — só com 4+ logos */}
  {brands.length >= 4 && (
    <div class="mt-14">
      <div class="flex items-center gap-5">
        <span aria-hidden="true" class="h-px flex-1 bg-primary-dark/15" />
        <p class="text-center font-sans text-[11.5px] font-bold tracking-[0.2em] text-ink-soft uppercase">
          {productLines.brandsLabel}
        </p>
        <span aria-hidden="true" class="h-px flex-1 bg-primary-dark/15" />
      </div>
      <ul
        class="mt-6 grid grid-cols-4 items-center gap-x-6 gap-y-5 lg:grid-cols-8"
        aria-label={productLines.brandsLabel}
      >
        {brands.map((brand) => (
          <li class="flex justify-center">
            <Image
              src={brand.src}
              alt={brand.name}
              format="webp"
              width={240}
              loading="lazy"
              decoding="async"
              class="h-12 w-auto opacity-80 brightness-[0.6] contrast-125 grayscale transition-[filter,opacity] duration-300 hover:opacity-100 hover:grayscale-0"
            />
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>

<style>
  /* Camada menta sobre o tom da seção, dissolvendo em branco na base */
  :global([data-linhas]) {
    background-image:
      radial-gradient(900px 420px at 85% 0%, rgb(97 229 169 / 0.12) 0%, transparent 70%),
      linear-gradient(180deg, #f0f9f5 0%, #f5fbf8 70%, #ffffff 100%);
  }

  /* Palco menta da foto, com brilho sob o produto */
  .linhas-stage {
    background-image:
      radial-gradient(ellipse 70% 55% at 50% 70%, rgb(97 229 169 / 0.24) 0%, transparent 72%),
      linear-gradient(180deg, #e9f6f0 0%, #f3faf7 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .linhas-card,
    .linhas-card * {
      transition: none !important;
    }
    .linhas-card:hover {
      transform: none;
    }
  }
</style>
