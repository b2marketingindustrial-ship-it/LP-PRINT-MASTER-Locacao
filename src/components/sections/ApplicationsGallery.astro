---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * Variante local da Print Master (mockup aprovado em 26/10/2026, docs/BRIEFING.md):
 * cabeçalho à esquerda com link à direita e 4 cards-botão — foto 6:5 com o número
 * no canto e painel verde-escuro com título, texto e seta. O card inteiro é o CTA,
 * por isso o `<button>` envolve a foto e o texto.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm}>
  <div class="pt-6 lg:pt-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
      <div class="max-w-4xl">
        <span class="inline-flex items-center gap-3 font-sans text-[12.5px] font-bold tracking-[0.22em] text-ink-soft uppercase">
          <span aria-hidden="true" class="size-3 rounded-[3px] bg-brand-mint"></span>
          {applications.eyebrow}
        </span>
        <h2 class="mt-4 max-w-[40rem] font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark sm:text-5xl lg:text-[3.35rem]">
          {applications.title}
        </h2>
        <p class="mt-4 font-sans text-[17px] leading-relaxed text-ink-soft sm:text-lg">
          {applications.text}
        </p>
      </div>

      <button
        type="button"
        data-cta="aplicacoes-cta"
        class="btn-slave-whats group inline-flex w-fit shrink-0 items-center gap-3 border-b-2 border-brand-mint pb-1.5 font-sans text-[16px] font-semibold text-primary-dark transition-colors duration-200 hover:text-accent-orange lg:mt-6"
      >
        {applications.cta}
        <Icon
          name="arrow-right"
          class="size-5 transition-transform duration-200 group-hover:translate-x-1"
        />
      </button>
    </div>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {applications.items.map((app, i) => (
        <li>
          <button
            type="button"
            data-cta={`aplicacoes-${app.id}`}
            class="btn-slave-whats app-card group relative flex h-full w-full flex-col overflow-hidden rounded-[20px] text-left ring-1 ring-primary-dark/10 shadow-[0_26px_50px_-30px_rgba(6,67,55,0.6)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_34px_64px_-30px_rgba(6,67,55,0.7)]"
          >
            <div class="relative aspect-[6/5] overflow-hidden bg-neutral-gray-100">
              <Image
                src={app.photo.src}
                alt={app.photo.alt}
                format="webp"
                width={640}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
              />
              <span class="absolute top-3 left-3 z-[2] flex size-11 items-center justify-center rounded-lg bg-primary-dark font-display text-[15px] font-extrabold text-neutral-light shadow-[0_8px_18px_-8px_rgba(0,0,0,0.5)]">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="app-panel flex flex-1 flex-col px-6 pt-5 pb-6">
              <span class="font-display text-[1.3rem] leading-snug font-extrabold text-neutral-light">
                {app.label}
              </span>
              <span class="mt-2 flex items-center justify-between gap-3">
                <span class="font-sans text-[14.5px] leading-relaxed text-neutral-light/85">
                  {app.description}
                </span>
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-mint-soft text-primary-dark transition-[background-color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-brand-mint">
                  <Icon name="arrow-right" class="size-5" />
                </span>
              </span>
            </div>
          </button>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .app-panel {
    background-image: linear-gradient(
      170deg,
      var(--color-primary-dark-800) 0%,
      var(--color-primary-dark) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
