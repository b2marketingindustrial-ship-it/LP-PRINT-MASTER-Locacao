---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * Variante local da Print Master (mockup aprovado em 26/10/2026, docs/BRIEFING.md):
 * cabeçalho centralizado e 4 cards-botão — foto 6:5 com o número
 * no canto e painel verde-escuro com título, texto e seta. O card inteiro é o CTA,
 * por isso o `<button>` envolve a foto e o texto.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Eyebrow from '@components/Eyebrow.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm} class="tex tex-dots tex-rings">
  <div class="pt-6 lg:pt-10">
    <div class="flex flex-col items-center text-center">
      <div>
        <Eyebrow>{applications.eyebrow}</Eyebrow>
        <h2 class="mx-auto mt-4 font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark text-balance sm:text-5xl lg:text-[3.35rem] lg:whitespace-nowrap">
          {applications.title}
        </h2>
        <p class="mt-4 font-sans text-[17px] leading-relaxed text-ink-soft sm:text-lg">
          {applications.text}
        </p>
      </div>
    </div>

    <ul
      class="apps-track scroll-track mt-10 -mx-6 flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pt-1 pb-8 lg:mx-0 lg:px-0"
      aria-label={applications.eyebrow}
    >
      {applications.items.map((app, i) => (
        <li class="apps-item w-[78%] shrink-0 snap-start sm:w-[calc((100%-20px)/2)] lg:w-[calc((100%-60px)/4)]">
          <button
            type="button"
            data-cta={`aplicacoes-${app.id}`}
            class="btn-slave-whats app-card group relative flex h-full w-full flex-col overflow-hidden rounded-[20px] text-left ring-1 ring-primary-dark/10 shadow-[0_26px_50px_-30px_rgba(6,67,55,0.6)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_34px_64px_-30px_rgba(6,67,55,0.7)]"
          >
            <div class="relative aspect-[6/5] overflow-hidden bg-neutral-gray-100">
              <Image
                src={app.photo.src}
                alt={app.photo.alt}
                format="webp"
                width={640}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
              />
              <span class="absolute top-3 left-3 z-[2] flex size-11 items-center justify-center rounded-lg bg-primary-dark font-display text-[15px] font-extrabold text-neutral-light shadow-[0_8px_18px_-8px_rgba(0,0,0,0.5)]">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="app-panel flex flex-1 flex-col px-6 pt-5 pb-6">
              <span class="font-display text-[1.3rem] leading-snug font-extrabold text-neutral-light">
                {app.label}
              </span>
              <span class="mt-2 flex items-center justify-between gap-3">
                <span class="font-sans text-[14.5px] leading-relaxed text-neutral-light/85">
                  {app.description}
                </span>
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-mint-soft text-primary-dark transition-[background-color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-brand-mint">
                  <Icon name="arrow-right" class="size-5" />
                </span>
              </span>
            </div>
          </button>
        </li>
      ))}
    </ul>

    <div class="flex items-center justify-center gap-3">
      <button
        type="button"
        data-rail-prev
        aria-label="Segmentos anteriores"
        class="flex size-11 items-center justify-center rounded-full border border-primary-dark/20 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:bg-accent-orange hover:text-neutral-light"
      >
        <Icon name="chevron-right" class="size-5 rotate-180" />
      </button>
      <button
        type="button"
        data-rail-next
        aria-label="Próximos segmentos"
        class="flex size-11 items-center justify-center rounded-full border border-primary-dark/20 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:bg-accent-orange hover:text-neutral-light"
      >
        <Icon name="chevron-right" class="size-5" />
      </button>
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('#aplicacoes').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.apps-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-rail-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-rail-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 20 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>

<style>
  .app-panel {
    background-image: linear-gradient(
      170deg,
      var(--color-primary-dark-800) 0%,
      var(--color-primary-dark) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
